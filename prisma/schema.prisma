generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  username     String
  avatarUrl    String?
  createdAt    DateTime @default(now())

  hintRequests HintRequest[]
  hintVotes    HintVote[]
}

model Crossword {
  id          String    @id @default(cuid())
  date        DateTime  @unique @db.Date // un crucigrama por día, ej. 2026-09-10
  title       String
  category    String
  difficulty  String
  language    String    @default("es-ES")
  imageUrl    String?
  authorId    String
  status      String    @default("draft") // draft|published|archived
  grid        Json
  createdAt   DateTime  @default(now())

  words       Word[]
  session     GlobalSession?
}

model Word {
  id          String    @id @default(cuid())
  crossword   Crossword @relation(fields: [crosswordId], references: [id])
  crosswordId String
  answer      String    // nunca se expone al frontend
  clue        String
  direction   String    // across | down
  row         Int
  col         Int
  number      Int
}

// Una única sesión compartida por crucigrama del día (todos los conectados la ven)
model GlobalSession {
  id           String    @id @default(cuid())
  crossword    Crossword @relation(fields: [crosswordId], references: [id])
  crosswordId  String    @unique
  state        Json      // celdas rellenas, quién rellenó cada una, etc.
  hintsUsed    Int       @default(0) // máximo 2 por día
  completed    Boolean   @default(false)
  completedAt  DateTime?
  startedAt    DateTime  @default(now())

  hintRequests HintRequest[]
}

// Propuesta de usar una de las 2 pistas diarias; se resuelve por votación sí/no
model HintRequest {
  id            String        @id @default(cuid())
  session       GlobalSession @relation(fields: [sessionId], references: [id])
  sessionId     String
  wordId        String        // palabra que se propone revelar
  requestedBy   User          @relation(fields: [requestedById], references: [id])
  requestedById String
  status        String        @default("pending") // pending | approved | rejected
  createdAt     DateTime      @default(now())
  resolvedAt    DateTime?

  votes         HintVote[]
}

model HintVote {
  id            String      @id @default(cuid())
  hintRequest   HintRequest @relation(fields: [hintRequestId], references: [id])
  hintRequestId String
  user          User        @relation(fields: [userId], references: [id])
  userId        String
  vote          Boolean     // true = sí, false = no
  createdAt     DateTime    @default(now())

  @@unique([hintRequestId, userId]) // un voto por usuario y propuesta
}
