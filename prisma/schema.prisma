generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guild {
  id         String    @id
  name       String
  timezone   String    @default("Europe/Madrid")
  credits    Int       @default(0)
  hintCost   Int       @default(2)
  createdAt  DateTime  @default(now())

  members    GuildMember[]
  creditLogs CreditLog[]
  settings   GuildSettings?
}

model User {
  id          String   @id
  username    String
  avatarHash  String?
  createdAt   DateTime @default(now())

  memberships GuildMember[]
}

model GuildMember {
  id       String   @id @default(cuid())
  guild    Guild    @relation(fields: [guildId], references: [id])
  guildId  String
  user     User     @relation(fields: [userId], references: [id])
  userId   String
  role     String   @default("member")
  rank     String?
  joinedAt DateTime @default(now())

  @@unique([guildId, userId])
}

model Crossword {
  id          String    @id @default(cuid())
  title       String
  type        String
  status      String    @default("draft")
  category    String
  difficulty  String
  language    String    @default("es-ES")
  imageUrl    String?
  authorId    String
  guildId     String?
  publishAt   DateTime?
  archivedAt  DateTime?
  grid        Json
  createdAt   DateTime  @default(now())

  words       Word[]
  sessions    CrosswordSession[]
}

model Word {
  id          String    @id @default(cuid())
  crossword   Crossword @relation(fields: [crosswordId], references: [id])
  crosswordId String
  answer      String
  clue        String
  direction   String
  row         Int
  col         Int
  number      Int
}

model CrosswordSession {
  id            String    @id @default(cuid())
  crossword     Crossword @relation(fields: [crosswordId], references: [id])
  crosswordId   String
  guildId       String
  state         Json
  completed     Boolean   @default(false)
  completedAt   DateTime?
  startedAt     DateTime  @default(now())
  archivedAt    DateTime?

  hintUsages    HintUsage[]
}

model CreditLog {
  id        String   @id @default(cuid())
  guild     Guild    @relation(fields: [guildId], references: [id])
  guildId   String
  delta     Int
  reason    String
  userId    String?
  sessionId String?
  createdAt DateTime @default(now())
}

model HintUsage {
  id        String           @id @default(cuid())
  session   CrosswordSession @relation(fields: [sessionId], references: [id])
  sessionId String
  wordId    String
  userId    String
  type      String
  cost      Int
  createdAt DateTime         @default(now())
}

model GuildSettings {
  guild               Guild   @relation(fields: [guildId], references: [id])
  guildId             String  @id
  notifyDaily         Boolean @default(true)
  notifyWeekly        Boolean @default(true)
  notifyCompletion    Boolean @default(true)
  notifyRewards       Boolean @default(true)
  voteApprovalMode    String  @default("simple_majority")
  allowFullRevealHint Boolean @default(false)
}
