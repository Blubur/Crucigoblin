generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Room {
  id             String    @id @default(cuid())
  name           String
  inviteCode     String    @unique // código corto para unirse, ej. "ABC123"
  timezone       String    @default("Europe/Madrid")
  credits        Int       @default(0)
  hintCost       Int       @default(2)
  createdAt      DateTime  @default(now())

  members        RoomMember[]
  creditLogs     CreditLog[]
  settings       RoomSettings?
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  username     String
  avatarUrl    String?
  createdAt    DateTime @default(now())

  memberships  RoomMember[]
}

model RoomMember {
  id       String   @id @default(cuid())
  room     Room     @relation(fields: [roomId], references: [id])
  roomId   String
  user     User     @relation(fields: [userId], references: [id])
  userId   String
  role     String   @default("member") // member | creator | admin
  rank     String?  // rango social editable, ej. "Vengo por la Ñ"
  joinedAt DateTime @default(now())

  @@unique([roomId, userId])
}

model Crossword {
  id          String    @id @default(cuid())
  title       String
  type        String    // daily | weekly | other
  status      String    @default("draft") // draft|review|approved|published|archived
  category    String
  difficulty  String
  language    String    @default("es-ES")
  imageUrl    String?
  authorId    String
  roomId      String?   // null si es plantilla global reutilizable
  publishAt   DateTime?
  archivedAt  DateTime?
  grid        Json
  createdAt   DateTime  @default(now())

  words       Word[]
  sessions    CrosswordSession[]
}

model Word {
  id          String    @id @default(cuid())
  crossword   Crossword @relation(fields: [crosswordId], references: [id])
  crosswordId String
  answer      String    // nunca se expone al frontend
  clue        String
  direction   String    // across | down
  row         Int
  col         Int
  number      Int
}

model CrosswordSession {
  id          String    @id @default(cuid())
  crossword   Crossword @relation(fields: [crosswordId], references: [id])
  crosswordId String
  roomId      String
  state       Json
  completed   Boolean   @default(false)
  completedAt DateTime?
  startedAt   DateTime  @default(now())
  archivedAt  DateTime?

  hintUsages  HintUsage[]
}

model CreditLog {
  id        String   @id @default(cuid())
  room      Room     @relation(fields: [roomId], references: [id])
  roomId    String
  delta     Int
  reason    String   // hint | completion | admin_adjust
  userId    String?
  sessionId String?
  createdAt DateTime @default(now())
}

model HintUsage {
  id        String           @id @default(cuid())
  session   CrosswordSession @relation(fields: [sessionId], references: [id])
  sessionId String
  wordId    String
  userId    String
  type      String
  cost      Int
  createdAt DateTime         @default(now())
}

model RoomSettings {
  room                Room    @relation(fields: [roomId], references: [id])
  roomId              String  @id
  notifyDaily         Boolean @default(true)
  notifyWeekly        Boolean @default(true)
  notifyCompletion    Boolean @default(true)
  notifyRewards       Boolean @default(true)
  voteApprovalMode    String  @default("simple_majority")
  allowFullRevealHint Boolean @default(false)
}
